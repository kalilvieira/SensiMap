# Copie para .env, preencha e exporte no terminal. Java não lê .env automaticamente.
# Valores abaixo são marcadores: use os dados fornecidos pela FIAP.
DB_URL='jdbc:oracle:thin:@//HOST_FIAP:1521/SERVICE_NAME_FIAP'
# Se a FIAP informar SID em vez de service name:
# DB_URL='jdbc:oracle:thin:@HOST_FIAP:1521:SID_FIAP'
DB_USER='USUARIO_FIAP'
DB_PASSWORD=''

# Somente no backend publicado. O provedor define PORT automaticamente.
# APP_ORIGIN deve ser a origem HTTPS exata do frontend, sem caminho nem barra final.
APP_ORIGIN='https://SEU-PROJETO.vercel.app'
